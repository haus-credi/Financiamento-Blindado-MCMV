---
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	/** Imagem de compartilhamento (1200 × 630), caminho dentro de /public. Ex.: "/og.jpg" */
	image?: string;
	/** Dispara o evento "Ver conteúdo" do Pixel da Meta. Só a página de vendas; as páginas legais passam false. */
	viewContent?: boolean;
}

const { title = SITE.title, description = SITE.description, image = SITE.image, viewContent = true } = Astro.props;

// canonical e og:image exigem URL absoluta: só são emitidos quando `site` está definido em astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<!-- Variantes oficiais do DS: data-title="hanzo|asimov" · data-tex="grad|flat" · data-accent="serif|sans" -->
<html lang="pt-BR" data-title="hanzo" data-tex="grad" data-accent="serif">
	<head>
		{/*
			Rastreamento (Google Tag Manager + Pixel da Meta) em DUAS etapas, para não disputar o processador com a foto da Hero:
			1) aqui, na hora, só as "filas": o dataLayer (Google Tag Manager) e o fbq() (Pixel) já guardam os comandos (PageView, ViewContent, clique);
			2) os arquivos pesados (gtm.js, e o gtag.js que o próprio GTM baixa em seguida; fbevents.js ~200 KB) só baixam depois que a página
			   abriu (evento load), a foto principal apareceu (LCP) e passou mais 1 s, ou antes, se a pessoa já começou a mexer na página
			   (rolar, tocar, teclar). Limite máximo: 8 s.
			Quando os arquivos chegam, eles processam a fila inteira. Nada se perde, só atrasa. Exceção: quem fecha a página
			ou clica em comprar antes disso não é contado.
			Google Tag Manager (GTM-NDV234Z9): ETAPA 2 da migração. O Google Analytics 4 (SITE.gaId) NÃO é mais carregado por este código:
			ele passa a ser uma tag DENTRO do contêiner (tag do Google com o G-GVZVLJ364M), que também envia o page_view. O código só
			alimenta o dataLayer (evento "begin_checkout", ver src/scripts/tracking.ts). Não reinstalar gtag('config') nem o gtag.js aqui:
			duplicaria o page_view. O Pixel da Meta continua direto por este código, fora do GTM.
		*/}
		<script is:inline define:vars={{ gtmId: SITE.gtmId, pixelId: SITE.metaPixelId, viewContent }}>
			window.dataLayer = window.dataLayer || [];
			// Google Tag Manager: mesmo "gtm.start" do código oficial do GTM; o gtm.js em si baixa junto com os outros (abaixo).
			dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });

			// fila do Pixel (igual ao código oficial da Meta, sem a parte que baixa o arquivo)
			!(function (f, n) {
				if (f.fbq) return;
				n = f.fbq = function () {
					n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
				};
				if (!f._fbq) f._fbq = n;
				n.push = n;
				n.loaded = !0;
				n.version = '2.0';
				n.queue = [];
			})(window);
			fbq('init', pixelId);
			fbq('track', 'PageView');
			if (viewContent) fbq('track', 'ViewContent'); // só a página de vendas; as páginas legais passam viewContent={false}

			(function () {
				var iniciado = false;
				var gatilhos = ['pointerdown', 'touchstart', 'keydown', 'scroll'];
				function baixar(url) {
					var s = document.createElement('script');
					s.async = true;
					s.src = url;
					document.head.appendChild(s);
				}
				function carregar() {
					if (iniciado) return;
					iniciado = true;
					gatilhos.forEach(function (g) {
						window.removeEventListener(g, carregar);
					});
					baixar('https://www.googletagmanager.com/gtm.js?id=' + gtmId);
					baixar('https://connect.facebook.net/en_US/fbevents.js');
				}
				// Modo de teste do GTM (Tag Assistant / Preview acrescenta gtm_debug ou gtm_preview na URL): carrega já, sem esperar.
				if (/[?&](gtm_debug|gtm_preview)=/.test(location.search)) carregar();
				gatilhos.forEach(function (g) {
					window.addEventListener(g, carregar, { passive: true, once: true });
				});
				// Começa só quando a página abriu (load) E a foto principal já apareceu (LCP), mais um respiro de 1 s.
				// Assim os scripts nunca entram na conta do LCP, por mais lento que seja o aparelho.
				var paginaAbriu = false;
				var fotoApareceu = true;
				function talvez() {
					if (paginaAbriu && fotoApareceu) setTimeout(carregar, 1000);
				}
				try {
					if (window.PerformanceObserver && PerformanceObserver.supportedEntryTypes.indexOf('largest-contentful-paint') > -1) {
						fotoApareceu = false;
						new PerformanceObserver(function (lista) {
							if (lista.getEntries().length) {
								fotoApareceu = true;
								talvez();
							}
						}).observe({ type: 'largest-contentful-paint', buffered: true });
					}
				} catch (e) {
					fotoApareceu = true;
				}
				function aoAbrir() {
					paginaAbriu = true;
					talvez();
				}
				if (document.readyState === 'complete') aoAbrir();
				else window.addEventListener('load', aoAbrir);
				// rede de segurança: se o navegador nunca avisar o LCP (aba em segundo plano, por exemplo)
				setTimeout(carregar, 8000);
			})();
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content={SITE.themeColor} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		{canonical && <link rel="canonical" href={canonical} />}
		{canonical && <meta property="og:url" content={canonical} />}
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<!-- habilita os efeitos de movimento; sem JS o conteúdo aparece normalmente -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<!-- Fontes do título (H1) — críticas para a primeira dobra -->
		<link rel="preload" href="/fonts/inter-display-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/instrument-serif-italic-400.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<!-- Google Tag Manager (noscript): só vale para quem está com JavaScript desligado, por isso não conflita com o carregamento tardio -->
		<noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<slot />
		<script>
			import '../scripts/motion.ts';
			import '../scripts/tracking.ts';
		</script>
	</body>
</html>
