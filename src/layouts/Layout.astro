---
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
	title?: string;
	description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
---

<!doctype html>
<!-- Variantes oficiais do DS: data-title="hanzo|asimov" · data-tex="grad|flat" · data-accent="serif|sans" -->
<html lang="pt-BR" data-title="hanzo" data-tex="grad" data-accent="serif">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content={SITE.themeColor} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<!-- habilita os efeitos de movimento; sem JS o conteúdo aparece normalmente -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<!-- Fontes do título (H1) — críticas para a primeira dobra -->
		<link rel="preload" href="/fonts/inter-display-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/instrument-serif-italic-400.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<slot />
		<script>
			import '../scripts/motion.ts';
		</script>
	</body>
</html>
