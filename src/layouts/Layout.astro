---
import '@fontsource/jetbrains-mono/latin-500.css';
import '../styles/global.css';
import { SITE } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	/** Imagem de compartilhamento (1200 × 630), caminho dentro de /public. Ex.: "/og.jpg" */
	image?: string;
}

const { title = SITE.title, description = SITE.description, image = SITE.image } = Astro.props;

// canonical e og:image exigem URL absoluta: só são emitidos quando `site` está definido em astro.config.mjs
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = image && Astro.site ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<!-- Variantes oficiais do DS: data-title="hanzo|asimov" · data-tex="grad|flat" · data-accent="serif|sans" -->
<html lang="pt-BR" data-title="hanzo" data-tex="grad" data-accent="serif">
	<head>
		{/* Google Tag Manager: logo após <head>, como o Google pede. is:inline mantém o trecho como foi fornecido. */}
		<script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${SITE.gtmId}`}></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
		</script>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content={SITE.themeColor} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={SITE.locale} />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
		{canonical && <link rel="canonical" href={canonical} />}
		{canonical && <meta property="og:url" content={canonical} />}
		{imageUrl && <meta property="og:image" content={imageUrl} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<!-- habilita os efeitos de movimento; sem JS o conteúdo aparece normalmente -->
		<script is:inline>document.documentElement.classList.add('js');</script>

		<!-- Fontes do título (H1) — críticas para a primeira dobra -->
		<link rel="preload" href="/fonts/inter-display-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/instrument-serif-italic-400.woff2" as="font" type="font/woff2" crossorigin />
		<slot name="head" />
	</head>
	<body>
		<slot />
		<script>
			import '../scripts/motion.ts';
		</script>
	</body>
</html>
