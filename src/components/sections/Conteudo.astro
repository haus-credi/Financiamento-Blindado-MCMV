---
/**
 * Dobra 05 — O que você vai aprender (conteúdo do curso). Versão CLEAN.
 * Copy aprovada, palavra por palavra. Função: responder "o que exatamente vou aprender?" em
 * poucas palavras — três resultados práticos, sem listas longas.
 *
 * Linguagem do DS ("Dobra clara"): campo claro com raios de luz, título centralizado com UMA
 * palavra em acento itálico e segundo tom, subheadline cujas palavras acendem com a rolagem
 * (`.words`) e três etapas separadas por filetes, sem cartões. Cada etapa tem um ícone do DS
 * (Phosphor, em disco claro) ao lado do título — sem numerais, para gastar menos altura.
 *
 * Rodapé numa só linha, só com peças do DS: as três características em pílulas de status (`.tab` +
 * `.dot` verde que pulsa) à esquerda e o botão à direita, alinhados com as bordas das etapas.
 * O botão desta dobra usa o tom beringela do DS (`tom="beringela"`); nas demais dobras ele é verde.
 * (A faixa de "Materiais de consulta" foi retirada desta dobra a pedido do cliente.)
 *
 * Desktop: a dobra tem a altura da janela (--fold-h) e o conteúdo fica centralizado nela, com a
 * mesma margem em cima e embaixo. Medidas em --fu (1px na janela de referência 1340 × 670).
 * Celular: tudo empilhado e centralizado; etapas em coluna.
 */
import CtaButton from '../ui/CtaButton.astro';
import { CHECKOUT_URL } from '../../config/site';
import iconePerfil from '@phosphor-icons/core/assets/regular/identification-card.svg?raw';
import iconeValores from '@phosphor-icons/core/assets/regular/calculator.svg?raw';
import iconeCredito from '@phosphor-icons/core/assets/regular/lifebuoy.svg?raw';

const pilares = [
	{
		icone: iconePerfil,
		titulo: 'Identifique quem tem perfil para financiar',
		texto: 'Entenda o enquadramento e a comprovação de renda, inclusive de clientes autônomos.',
	},
	{
		icone: iconeValores,
		titulo: 'Explique os valores sem improvisar',
		texto: 'Domine entrada, subsídio, FGTS, parcelas e evolução de obra para transmitir segurança ao comprador.',
	},
	{
		icone: iconeCredito,
		titulo: 'Saiba agir quando o crédito não avança',
		texto: 'Identifique possíveis obstáculos, situações que podem ser reavaliadas e os próximos passos junto ao banco.',
	},
];

const caracteristicas = ['Aulas gravadas', 'Linguagem simples', 'Exemplos práticos'];
---

<section id="o-que-voce-aprende" class="aprende" aria-labelledby="aprende-title">
	<div class="rays" aria-hidden="true">
		<div class="rays-in"><i class="r1"></i><i class="r2"></i><i class="r4"></i></div>
	</div>

	<div class="aprende__inner">
		<header class="aprende__head">
			<h2 id="aprende-title" class="aprende__title rv">
				<span class="aprende__l1">O que você vai <em class="acc">aprender</em> no</span>{' '}<span class="t2"
					>Financiamento Blindado.</span
				>
			</h2>
			<p class="aprende__sub rv" style="--i:1" data-words>
				O Minha Casa, Minha Vida aplicado à venda de imóveis na planta.
			</p>
		</header>

		<ol class="aprende__pilares">
			{
				pilares.map((p, i) => (
					<li class="pilar rv" style={`--i:${i + 1}`}>
						<span class="pilar__ico" aria-hidden="true" set:html={p.icone} />
						<h3 class="pilar__titulo">{p.titulo}</h3>
						<p class="pilar__texto">{p.texto}</p>
					</li>
				))
			}
		</ol>

		<div class="aprende__rodape">
			<ul class="aprende__carac rv" style="--i:1">
				{
					caracteristicas.map((c, i) => (
						<li class="tab" style={`--d:${i * 0.8}s`}>
							<span class="dot" aria-hidden="true" />
							{c}
						</li>
					))
				}
			</ul>

			<div class="aprende__cta rv" style="--i:2">
				<CtaButton href={CHECKOUT_URL} fundo="claro" tom="beringela">QUERO APRENDER NA PRÁTICA</CtaButton>
			</div>
		</div>
	</div>
</section>

<style>
	.aprende {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		/* campo do DS (225°, branco → cinza), mais luminoso que o da dobra 4; as faixas de cima e de
		   baixo dissolvem no campo liso: sem emenda com a dobra 4 nem com a próxima */
		background:
			linear-gradient(180deg, var(--field) 0%, rgba(217, 218, 215, 0) 26%),
			linear-gradient(0deg, var(--field) 0%, rgba(217, 218, 215, 0) 18%),
			linear-gradient(225deg, var(--field-hi) 0%, var(--field) 100%);
		padding: clamp(64px, 12vw, 104px) clamp(22px, 5vw, 56px) clamp(64px, 12vw, 104px);
	}
	/* raios de luz do DS (três), só no miolo: sem emenda com as dobras vizinhas */
	.aprende :global(.rays) {
		-webkit-mask-image: linear-gradient(transparent 0%, #000 30%, #000 70%, transparent 100%);
		mask-image: linear-gradient(transparent 0%, #000 30%, #000 70%, transparent 100%);
	}
	.aprende__inner {
		position: relative;
		z-index: 2;
		max-width: 1120px;
		margin: 0 auto;
		display: grid;
		gap: clamp(36px, 8vw, 56px);
	}

	/* ------------------------------------------------------------------ cabeçalho */
	.aprende__head {
		text-align: center;
	}
	.aprende__title {
		margin: 0;
		font-family: var(--f-title);
		font-weight: 500;
		font-size: var(--fs-h2);
		line-height: 1.06;
		letter-spacing: var(--title-ls);
		color: var(--tx);
		text-wrap: balance;
	}
	.aprende__title .acc {
		font-size: calc(1em * var(--acc-scale));
		letter-spacing: -0.01em;
		padding-right: 0.04em;
	}
	/* composição em duas linhas: "O que você vai aprender no" / "Financiamento Blindado." */
	.aprende__title .t2 {
		display: block;
		/* segundo tom com corpo (igual ao das outras dobras) */
		color: rgba(var(--ink-rgb), 0.72);
	}
	:global(:root[data-tex='grad']) .aprende__title .t2 {
		background-image: linear-gradient(180deg, rgba(14, 26, 19, 0.92) 0%, rgba(14, 26, 19, 0.66) 100%);
	}
	.aprende__sub {
		margin: clamp(14px, 3vw, 20px) auto 0;
		max-width: 34rem;
		font: 400 var(--fs-body) / 1.5 var(--f-display);
		letter-spacing: -0.01em;
		color: var(--tx-body);
		text-wrap: balance;
	}

	/* --------------------------------------- as três etapas: ícone + título, depois a descrição */
	.aprende__pilares {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		border-top: 1px solid rgba(var(--ink-rgb), 0.2);
	}
	.pilar {
		position: relative;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		grid-template-areas:
			'ico titulo'
			'texto texto';
		align-items: center;
		/* as linhas ficam coladas no topo: ícone e título alinhados entre as três etapas */
		align-content: start;
		column-gap: 0.8em;
		row-gap: 0.7em;
		padding: clamp(26px, 6vw, 34px) 0;
		font-size: var(--fs-item);
	}
	/* segmento verde na régua: marca o início de cada etapa */
	.pilar::before {
		content: '';
		position: absolute;
		top: -1px;
		left: 0;
		width: 56px;
		height: 3px;
		border-radius: 2px;
		background: var(--v500);
		transition: width 0.7s var(--ease-out);
	}
	.pilar + .pilar {
		border-top: 1px solid rgba(var(--ink-rgb), 0.14);
	}
	.pilar + .pilar::before {
		top: -2px;
	}
	/* ícone do DS (Phosphor) em disco claro */
	.pilar__ico {
		grid-area: ico;
		display: grid;
		place-items: center;
		width: 2.6em;
		height: 2.6em;
		border-radius: 50%;
		background: var(--v200);
		color: var(--v700);
		transition:
			background-color 0.5s var(--ease-hz),
			color 0.5s var(--ease-hz);
	}
	.pilar__ico :global(svg) {
		width: 1.4em;
		height: 1.4em;
		fill: currentColor;
	}
	.pilar__titulo {
		grid-area: titulo;
		margin: 0;
		font: 500 1.4em / 1.18 var(--f-display);
		letter-spacing: -0.035em;
		color: var(--tx);
		text-wrap: balance;
	}
	.pilar__texto {
		grid-area: texto;
		margin: 0;
		max-width: 30rem;
		font: 400 0.92em / 1.55 var(--f-display);
		letter-spacing: -0.005em;
		color: var(--tx-body);
		text-wrap: pretty;
	}
	/* ao passar o mouse: o segmento da régua se estende e o ícone se enche de verde */
	@media (hover: hover) {
		.pilar:hover::before {
			width: 112px;
		}
		.pilar:hover .pilar__ico {
			background: var(--v500);
			color: #fff;
		}
	}

	/* ------------------------------------------------ rodapé: tudo sobre o eixo central */
	.aprende__rodape {
		display: grid;
		justify-items: center;
		gap: clamp(20px, 5vw, 24px);
		text-align: center;
	}
	/* características: pílulas de status do DS (.tab) com o ponto verde que pulsa (.dot) */
	.aprende__carac {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px;
		font-size: var(--fs-item);
	}
	.tab {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		height: 2.5em;
		padding: 0 1.2em;
		border-radius: 999px;
		background: var(--surface);
		box-shadow: var(--sh-soft);
		font: 400 0.88em / 1 var(--f-display);
		letter-spacing: -0.02em;
		color: var(--tx);
		white-space: nowrap;
	}
	.dot {
		position: relative;
		flex: none;
		width: 0.55em;
		height: 0.55em;
		border-radius: 50%;
		background: var(--v500);
	}
	@media (prefers-reduced-motion: no-preference) {
		.dot::after {
			content: '';
			position: absolute;
			inset: 0;
			border-radius: 50%;
			background: inherit;
			animation: aprende-dot 2.4s var(--ease-out) var(--d, 0s) infinite;
		}
	}
	@keyframes aprende-dot {
		0% {
			transform: scale(1);
			opacity: 0.6;
		}
		100% {
			transform: scale(2.8);
			opacity: 0;
		}
	}

	/* celular: pílulas menores para as três caberem juntas; sem pílula solta */
	@media (max-width: 599px) {
		.aprende__carac {
			gap: 8px;
			font-size: clamp(13px, 3.6vw, 15px);
		}
		.tab {
			padding: 0 0.95em;
		}
	}

	/* tablet: etapas ainda em coluna única, um pouco mais de largura de leitura */
	@media (min-width: 600px) and (max-width: 899px) {
		.pilar__texto {
			max-width: 36rem;
		}
	}

	/* desktop: as três etapas lado a lado, separadas por filetes verticais */
	@media (min-width: 900px) {
		.aprende__pilares {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.pilar + .pilar {
			border-top: 0;
			border-left: 1px solid rgba(var(--ink-rgb), 0.14);
		}
		.pilar + .pilar::before {
			top: -1px;
			left: -1px;
		}
		.pilar {
			padding-right: clamp(20px, 2.4vw, 36px);
		}
		.pilar + .pilar {
			padding-left: clamp(20px, 2.4vw, 36px);
		}
		.aprende__title {
			letter-spacing: -0.055em;
			line-height: 1.04;
		}
	}

	/* desktop: a dobra = caixa de texto + colchão (--half) em cima e embaixo (ver --delta em
	   tokens.css). Medidas em --fu (1px na janela de referência 1340 × 670).
	   Ritmo vertical único: o mesmo intervalo (--gap) entre cabeçalho, etapas e rodapé. */
	@media (min-width: 900px) and (min-aspect-ratio: 1/1) {
		.aprende {
			--gap: calc(48 * var(--fu));
			display: grid;
			align-content: center;
			padding: calc(var(--half) + 7 * var(--fu)) calc(56 * var(--fu)) calc(var(--half) - 19 * var(--fu));
		}
		.aprende__inner {
			width: 100%;
			max-width: calc(1100 * var(--fu));
			gap: var(--gap);
		}
		.aprende__sub {
			max-width: none;
			margin-top: calc(16 * var(--fu));
		}
		.pilar {
			padding-block: calc(36 * var(--fu)) calc(32 * var(--fu));
			padding-right: calc(34 * var(--fu));
			row-gap: calc(16 * var(--fu));
		}
		.pilar + .pilar {
			padding-left: calc(34 * var(--fu));
		}
		.pilar__ico {
			width: 2.9em;
			height: 2.9em;
		}
		.pilar__titulo {
			font-size: calc(var(--fs-item) * 1.5);
		}
		.pilar__texto {
			max-width: none;
			font-size: 0.98em;
		}

		/* rodapé: pílulas à esquerda e botão à direita, nas mesmas bordas das etapas */
		.aprende__rodape {
			grid-template-columns: minmax(0, 1fr) auto;
			justify-items: stretch;
			align-items: center;
			gap: calc(40 * var(--fu));
			text-align: left;
		}
		.aprende__carac {
			justify-content: flex-start;
			gap: calc(12 * var(--fu));
		}
		/* botão do DS (60px, disco 44px, rótulo 14,5px) na mesma escala da composição */
		.aprende__cta :global(a.cta) {
			--h: calc(56 * var(--fu));
			--disc: calc(40 * var(--fu));
			gap: calc(20 * var(--fu));
			padding-left: calc(28 * var(--fu));
			font-size: calc(14.5 * var(--fu));
		}
	}
</style>
