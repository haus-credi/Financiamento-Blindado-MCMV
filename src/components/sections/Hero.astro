---
/**
 * Dobra 01 — Hero.
 *
 * Desktop: a Hero ocupa a janela inteira (largura toda × altura da janela), sem moldura.
 * Toda a composição escala com a ALTURA da janela (--u = altura ÷ 670px): a fotografia tem a
 * altura da Hero e encosta na borda direita; texto, título e botão crescem na mesma proporção.
 * Resultado: a dobra fica igual em qualquer zoom ou tamanho de janela com a mesma proporção
 * (referência: janela 1520 × 670 → título 70,4px, texto 24px, botão 60px).
 * Retrato/mobile: texto e botão primeiro, fotografia inteira logo abaixo.
 * Animação 100% CSS: o conteúdo é visível mesmo sem JS e com prefers-reduced-motion.
 */
import { Picture } from 'astro:assets';
import defaultPhoto from '../../assets/hero/dobra-parede-lisa.png';
import Botao from '../ui/Botao.astro';
import { CHECKOUT_URL } from '../../config/site';

interface Props {
	/** Fotografia de fundo (1670 × 941). Padrão: dobra-parede-lisa.png (versão B, a principal) */
	photo?: ImageMetadata;
	/** 'clean' = parede lisa à esquerda: névoa de leitura mais leve */
	variant?: 'default' | 'clean';
}

const { photo = defaultPhoto, variant = 'clean' } = Astro.props;
---

<section class:list={['hero', { 'hero--clean': variant === 'clean' }]} aria-labelledby="hero-title">
	<div class="hero__frame on-ink">
		<div class="hero__media">
			<Picture
				src={photo}
				alt="Especialista em financiamento imobiliário sorrindo, sentada à mesa do seu escritório"
				formats={['webp']}
				fallbackFormat="jpg"
				widths={[960, 1280, 1670]}
				sizes="(min-width: 861px) and (min-aspect-ratio: 1/1) 1500px, 190vw"
				quality={100}
				priority
				class="hero__photo"
				pictureAttributes={{ class: 'hero__picture' }}
			/>
			<div class="hero__scrim" aria-hidden="true"></div>
		</div>
		<div class="hero__light" aria-hidden="true">
			<div class="hero__light-in"><i class="r1"></i><i class="r3"></i><i class="r4"></i></div>
		</div>

		<div class="hero__inner">
			<div class="hero__content">
				<p class="hero__kicker">
					<span class="hero__kicker-rule" aria-hidden="true"></span>
					<span class="hero__kicker-text">
						<span class="hero__kicker-name">FINANCIAMENTO BLINDADO</span>{' '}
						<span class="hero__kicker-aud">MINHA CASA MINHA VIDA</span>
					</span>
				</p>

				<h1 id="hero-title" class="hero__title">
					<span class="hero__line" style="--l:0">Venda mais <em class="acc">imóveis na planta</em></span>{' '}
					<span class="hero__line t2" style="--l:1">sem travar no financiamento</span>
				</h1>

				<p class="hero__lead">
					Domine as regras do Minha Casa, Minha Vida, esclareça as dúvidas dos seus clientes e conduza suas vendas com
					mais segurança.
				</p>

				<div class="hero__cta">
					<Botao variante="brilho" fundo="escuro" href={CHECKOUT_URL} icone="arrow-right" class="hero__button">QUERO ME TORNAR REFERÊNCIA</Botao>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* ================================================================ BASE = RETRATO / MOBILE
	   Texto e botão primeiro (CTA visível logo ao abrir), fotografia inteira logo
	   abaixo: o topo da foto se dissolve na tinta. Sem moldura arredondada. */
	.hero__frame {
		--ink-0: rgba(var(--ink-rgb), 0);
		position: relative;
		/* acima do ruído fixo do DS (z-index 90): a textura nunca granula a fotografia */
		z-index: 91;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		background: var(--v950);
		color: #fff;
	}

	.hero__inner {
		order: 1;
		position: relative;
		z-index: 1;
		padding: clamp(40px, 10vw, 76px) clamp(20px, 6vw, 56px) 0;
	}

	.hero__media {
		order: 2;
		position: relative;
		z-index: 0;
		height: clamp(360px, 106vw, 680px);
		margin-top: clamp(-40px, -6vw, -24px);
	}

	.hero__media :global(.hero__picture) {
		position: absolute;
		inset: 0;
	}

	.hero__photo {
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		object-position: 100% 100%;
	}

	/* névoa de cima para baixo: a foto sai da tinta do bloco de texto */
	.hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			var(--v950) 0%,
			rgba(var(--ink-rgb), 0.82) 9%,
			rgba(var(--ink-rgb), 0.45) 20%,
			rgba(var(--ink-rgb), 0.14) 32%,
			var(--ink-0) 42%
		);
	}

	.hero__light {
		display: none;
	}

	.hero__content {
		max-width: 36rem;
	}

	/* identificação: H6 do DS (JetBrains Mono, caixa-alta) com fio vertical */
	.hero__kicker {
		display: flex;
		align-items: stretch;
		gap: 14px;
		margin-bottom: 20px;
		font: 500 11.5px/1.55 var(--f-mono);
		letter-spacing: 0.14em;
	}
	.hero__kicker-rule {
		flex: none;
		width: 1px;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.7), rgba(255, 255, 255, 0.15));
		transform-origin: top;
	}
	.hero__kicker-text {
		display: flex;
		flex-direction: column;
	}
	.hero__kicker-name {
		color: rgba(255, 255, 255, 0.92);
	}
	.hero__kicker-aud {
		color: rgba(255, 255, 255, 0.52);
	}

	/* H1: display do DS (Inter Display 400, -0.06em, segundo tom em degradê).
	   No celular quebra naturalmente e entra como um bloco só. */
	.hero__title {
		font-family: var(--f-title);
		font-weight: var(--title-w);
		font-size: clamp(2rem, 8.6vw, 3.5rem);
		line-height: 1.08;
		letter-spacing: var(--title-ls);
		color: #fff;
		text-wrap: balance;
	}
	.hero__line {
		display: inline;
		padding-bottom: 0.04em;
	}
	.hero__title .acc {
		font-size: calc(1em * var(--acc-scale));
		line-height: 0.9;
		letter-spacing: -0.01em;
		padding-right: 0.04em;
	}

	.hero__lead {
		max-width: 36rem;
		margin-top: 18px;
		font: 400 clamp(16.5px, 4.3vw, 19px) / 1.55 var(--f-display);
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.76);
		text-wrap: pretty;
	}
	.hero__lead strong {
		font-weight: 500;
		color: #fff;
	}

	.hero__cta {
		margin-top: 26px;
	}

	@media (max-width: 560px) {
		.hero__cta :global(.hero__button) {
			display: flex;
			width: 100%;
		}
	}

	/* ================================================================ ENTRADA
	   "appear" do DS (sobe + opacidade + desfoque → nítido, --ease-out), em
	   sequência: identificação → título → texto de apoio → botão. */
	.hero__kicker-text,
	.hero__lead,
	.hero__cta {
		animation: hero-rise 1.1s var(--ease-out) both;
	}
	.hero__title {
		animation: hero-rise 1.1s var(--ease-out) 0.28s both;
	}
	.hero__kicker-text {
		animation-delay: 0.1s;
	}
	.hero__kicker-rule {
		animation: hero-draw 1.2s var(--ease-out) 0.05s both;
	}
	.hero__lead {
		animation-delay: 0.7s;
	}
	.hero__cta {
		animation-delay: 0.88s;
	}

	@keyframes hero-rise {
		from {
			opacity: 0;
			transform: translate3d(0, 22px, 0);
			filter: blur(8px);
		}
		to {
			opacity: 1;
			transform: none;
			filter: none;
		}
	}
	@keyframes hero-draw {
		from {
			transform: scaleY(0);
		}
		to {
			transform: none;
		}
	}
	@keyframes hero-fade {
		to {
			opacity: 1;
		}
	}
	@keyframes ray-drift {
		from {
			transform: skewX(45deg) translateX(-4%);
		}
		to {
			transform: skewX(45deg) translateX(4%);
		}
	}

	/* ================================================================ DESKTOP — TELA CHEIA
	   A Hero preenche a janela (largura e altura). Tudo é medido em --u, que é a
	   altura da Hero dividida por 670px: em 1520 × 670, --u = 1 e os valores abaixo
	   são os de referência; em qualquer outra altura a composição escala junto. */
	@media (min-width: 861px) and (min-aspect-ratio: 1/1) {
		.hero {
			overflow: hidden;
			/* --header-h reserva espaço para um cabeçalho fixo futuro (0 por enquanto) */
			--header-h: 0px;
			/* campo do DS (225°) que termina em --field na base, sem emenda com a página */
			background:
				linear-gradient(180deg, transparent 55%, var(--field) 100%),
				linear-gradient(225deg, var(--field-hi) 0%, var(--field) 100%);
		}

		.hero__frame {
			/* altura da Hero = altura da janela (menos o cabeçalho): a primeira dobra
			   inteira, com o CTA, cabe sem rolagem vertical. Mínimo de 480px. */
			--H: clamp(480px, calc(100svh - var(--header-h)), 1400px);
			/* unidade da composição: 1u = 1px na janela de referência (altura 670px) */
			--u: calc(var(--H) / 670);
			/* início da coluna de texto: 110u da borda esquerda da janela */
			--left: calc(110 * var(--u));
			/* A foto tem a altura da Hero (--H) e encosta na borda direita da janela
			   (sem corte, sem deformação). O rosto/cabelo começa em 62% da foto. A
			   coluna de texto vai até 120u antes dele: texto e especialista ficam
			   juntos, e o título cresce quando sobra espaço. */
			--pw: calc(var(--H) * 1.7747);
			--hair: calc(100vw - var(--pw) * 0.38);
			--col: clamp(calc(420 * var(--u)), calc(var(--hair) - 120 * var(--u) - var(--left)), calc(860 * var(--u)));

			display: block;
			position: relative;
			width: 100%;
			height: var(--H);
			background: var(--v950);
		}

		/* ---- fotografia: reduzida PROPORCIONALMENTE para ter exatamente a altura
		   da Hero (sem corte, sem deformação), encostada na borda direita do palco.
		   A borda esquerda se dissolve na tinta, do lado do texto; do lado da
		   especialista não há névoa. ---- */
		.hero__media {
			position: absolute;
			top: 0;
			right: 0;
			height: var(--H);
			width: calc(var(--H) * 1.7747); /* 1670 × 941 */
			margin: 0;
			z-index: -2;
			-webkit-mask-image: linear-gradient(90deg, transparent 0, rgba(0, 0, 0, 0.06) 6%, rgba(0, 0, 0, 0.22) 13%, rgba(0, 0, 0, 0.5) 20%, rgba(0, 0, 0, 0.8) 27%, #000 34%);
			mask-image: linear-gradient(90deg, transparent 0, rgba(0, 0, 0, 0.06) 6%, rgba(0, 0, 0, 0.22) 13%, rgba(0, 0, 0, 0.5) 20%, rgba(0, 0, 0, 0.8) 27%, #000 34%);
		}
		.hero__photo {
			object-fit: fill;
			object-position: 0 0;
		}

		/* névoa de leitura (percentuais da foto): forte sob o texto, termina antes
		   do rosto, que começa em ~62% da largura da foto */
		.hero__scrim {
			background:
				linear-gradient(
					90deg,
					rgba(var(--ink-rgb), 0.94) 0%,
					rgba(var(--ink-rgb), 0.9) 20%,
					rgba(var(--ink-rgb), 0.8) 32%,
					rgba(var(--ink-rgb), 0.58) 42%,
					rgba(var(--ink-rgb), 0.3) 50%,
					rgba(var(--ink-rgb), 0.1) 57%,
					var(--ink-0) 63%
				),
				linear-gradient(180deg, rgba(var(--ink-rgb), 0.34) 0%, var(--ink-0) 26%),
				linear-gradient(0deg, rgba(var(--ink-rgb), 0.45) 0%, var(--ink-0) 30%);
		}

		/* luz ambiente: raios a 45° do DS em ~4.5% de branco, só do lado do texto */
		.hero__light {
			display: block;
			position: absolute;
			inset: 0;
			z-index: -1;
			overflow: hidden;
			pointer-events: none;
			-webkit-mask-image: linear-gradient(90deg, #000 0%, #000 30%, transparent 55%);
			mask-image: linear-gradient(90deg, #000 0%, #000 30%, transparent 55%);
			opacity: 0;
			animation: hero-fade 2.4s var(--ease-out) 0.6s forwards;
		}
		.hero__light-in {
			position: absolute;
			inset: -12% -10%;
		}
		.hero__light i {
			position: absolute;
			top: -14%;
			height: 128%;
			background: linear-gradient(#fff 0%, #fff 84%, rgba(255, 255, 255, 0) 100%);
			opacity: 0.045;
			transform: skewX(45deg);
			will-change: transform;
			animation: ray-drift 42s var(--ease-hz) infinite alternate;
		}
		.hero__light .r1 {
			left: -8%;
			width: 41%;
			-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 20%, transparent 36%, #000 55%, rgba(0, 0, 0, 0.13) 67%, #000 78%, transparent 97%);
			mask-image: linear-gradient(90deg, transparent 0%, #000 20%, transparent 36%, #000 55%, rgba(0, 0, 0, 0.13) 67%, #000 78%, transparent 97%);
		}
		.hero__light .r3 {
			left: -2%;
			width: 31%;
			animation-delay: -17s;
			-webkit-mask-image: linear-gradient(90deg, transparent 10%, #000 20%, rgba(0, 0, 0, 0.55) 29%, rgba(0, 0, 0, 0.42) 40%, #000 49%, rgba(0, 0, 0, 0.27) 55%, rgba(0, 0, 0, 0.13) 79%, #000 89%, transparent);
			mask-image: linear-gradient(90deg, transparent 10%, #000 20%, rgba(0, 0, 0, 0.55) 29%, rgba(0, 0, 0, 0.42) 40%, #000 49%, rgba(0, 0, 0, 0.27) 55%, rgba(0, 0, 0, 0.13) 79%, #000 89%, transparent);
		}
		.hero__light .r4 {
			left: 6%;
			width: 48%;
			animation-delay: -25s;
			-webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 18%, rgba(0, 0, 0, 0.55) 27%, #000 35%, transparent 48%, rgba(0, 0, 0, 0.13) 69%, #000 79%, transparent 97%);
			mask-image: linear-gradient(90deg, transparent 0%, #000 18%, rgba(0, 0, 0, 0.55) 27%, #000 35%, transparent 48%, rgba(0, 0, 0, 0.13) 69%, #000 79%, transparent 97%);
		}

		/* ---- texto: coluna a 110u da borda esquerda, identificação em 12% da altura ---- */
		.hero__inner {
			position: absolute;
			left: var(--left);
			top: calc(var(--H) * 0.12);
			width: var(--col);
			padding: 0;
		}
		.hero__content {
			max-width: none;
		}

		.hero__kicker {
			margin-bottom: calc(var(--H) * 0.055);
			gap: calc(14 * var(--u));
			font-size: calc(13 * var(--u));
		}

		/* título: cada linha entra em sequência; tamanho acompanha a coluna */
		.hero__title {
			font-size: calc(var(--col) / 11.9);
			line-height: 1.08;
			text-wrap: nowrap;
			animation: none;
		}
		.hero__line {
			display: block;
			white-space: nowrap;
			animation: hero-rise 1.1s var(--ease-out) both;
			animation-delay: calc(0.28s + var(--l) * 0.12s);
		}

		.hero__lead {
			max-width: calc(var(--col) * 0.88);
			margin-top: calc(var(--H) * 0.04);
			font-size: clamp(calc(14 * var(--u)), calc(var(--col) * 0.03), calc(24 * var(--u)));
		}

		.hero__cta {
			margin-top: calc(var(--H) * 0.093);
		}
		/* botão "Brilho" (62px de altura, rótulo 15px) na mesma escala da composição */
		.hero__cta {
			--bt-u: var(--u);
		}
	}

	/* ================================================================ VARIANTE 'clean'
	   Foto com parede lisa à esquerda: não há o que esconder, então a névoa só
	   garante contraste do texto e a cor da parede aparece viva. */
	@media (min-width: 861px) and (min-aspect-ratio: 1/1) {
		.hero--clean .hero__scrim {
			background:
				linear-gradient(
					90deg,
					rgba(var(--ink-rgb), 0.5) 0%,
					rgba(var(--ink-rgb), 0.42) 24%,
					rgba(var(--ink-rgb), 0.26) 40%,
					rgba(var(--ink-rgb), 0.1) 52%,
					var(--ink-0) 62%
				),
				linear-gradient(0deg, rgba(var(--ink-rgb), 0.4) 0%, var(--ink-0) 28%);
		}
	}

	/* ================================================================ SEM MOVIMENTO */
	@media (prefers-reduced-motion: reduce) {
		.hero__kicker-text,
		.hero__kicker-rule,
		.hero__title,
		.hero__line,
		.hero__lead,
		.hero__cta,
		.hero__light,
		.hero__light i {
			animation: none;
		}
		.hero__light {
			opacity: 1;
		}
	}
</style>
