---
/**
 * Rodapé (depois do FAQ): curto, de uma linha e CLARO, como o resto da página (referência do cliente:
 * uma barra fina, com o texto da empresa de um lado e a assinatura do outro).
 *
 * Texto (escrito por nós, só com o que a página já diz):
 *   · esquerda: "Financiamento Blindado - Minha Casa Minha Vida"
 *   · centro:   links para Termos de Uso e Política de Privacidade (páginas /termos e /privacidade)
 *   · direita:  "© 2026 Haus Credi. CNPJ: ..." (dados em EMPRESA, src/config/site.ts; CNPJ fornecido
 *     pelo cliente, dígitos verificadores conferidos)
 * Sem "todos os direitos reservados".
 *
 * Não é uma dobra (não segue a altura da janela). Medidas em --fu no desktop.
 */
import { EMPRESA } from '../../config/site';
---

<footer class="rodape">
	<!-- campo do DS: o mesmo da FAQ e da Oferta (cinza em 225° com raios de luz) -->
	<div class="rays" aria-hidden="true">
		<div class="rays-in"><i class="r1"></i><i class="r3"></i><i class="r4"></i></div>
	</div>
	<div class="rodape__inner">
		<p class="rodape__texto"><strong>Financiamento Blindado - Minha Casa Minha Vida</strong></p>
		<nav class="rodape__links" aria-label="Documentos legais">
			<a href="/termos/">Termos de Uso</a>
			<a href="/privacidade/">Política de Privacidade</a>
			<a href="/cookies/">Política de Cookies</a>
		</nav>
		<p class="rodape__copy">© 2026 {EMPRESA.nome}. CNPJ: {EMPRESA.cnpj}.</p>
		<!-- Aviso (13/11/2026), no formato curto que o cliente preferiu: abre com a independência da Caixa e do
		     Governo Federal e fecha com "não há garantia de resultados". -->
		<p class="rodape__aviso">
			Este site não é afiliado, patrocinado ou endossado pela Caixa Econômica Federal ou pelo Governo Federal. Não há garantia
			de resultados financeiros, profissionais ou comerciais. Os resultados podem variar.
		</p>
	</div>
</footer>

<style>
	.rodape {
		position: relative;
		z-index: 2;
		isolation: isolate;
		overflow: hidden;
		/* campo do DS (225°, branco → cinza), igual ao da FAQ; o topo dissolve no campo liso em que a
		   FAQ termina, sem emenda. Um filete fino no topo continua separando as duas peças. */
		/* o claro do degradê é um branco rebaixado (#ecedeb), não o branco puro: numa barra baixa o
		   branco inteiro leria como "rodapé branco" de novo */
		background:
			linear-gradient(180deg, var(--field) 0%, rgba(217, 218, 215, 0) 100%),
			linear-gradient(225deg, #ecedeb 0%, var(--field) 100%);
		border-top: 1px solid rgba(var(--ink-rgb), 0.12);
		padding: 22px clamp(22px, 5vw, 56px);
	}
	/* raios de luz do DS (três): numa barra baixa eles aparecem só como estrias suaves, a meia força */
	.rodape :global(.rays) {
		opacity: 0.5;
		-webkit-mask-image: linear-gradient(transparent 0%, #000 60%, #000 100%);
		mask-image: linear-gradient(transparent 0%, #000 60%, #000 100%);
	}
	.rodape__inner {
		position: relative;
		z-index: 2;
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 6px 32px;
	}
	.rodape__texto,
	.rodape__copy {
		margin: 0;
		font: 400 13.5px / 1.5 var(--f-display);
		letter-spacing: -0.005em;
		color: var(--tx-body);
	}
	.rodape__texto :global(strong) {
		font-weight: 500;
		color: var(--tx);
	}
	/* aviso: segunda linha, largura toda, discreto, separado por um filete fino */
	.rodape__aviso {
		flex: 0 0 100%;
		margin: 10px 0 0;
		padding-top: 14px;
		border-top: 1px solid rgba(var(--ink-rgb), 0.1);
		font: 400 12px / 1.6 var(--f-display);
		letter-spacing: -0.005em;
		color: var(--tx-2);
		text-wrap: pretty;
	}
	.rodape__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 4px 22px;
		font: 400 13.5px / 1.5 var(--f-display);
		letter-spacing: -0.005em;
	}
	.rodape__links a {
		color: var(--tx-body);
		text-decoration: underline;
		text-decoration-color: rgba(var(--ink-rgb), 0.25);
		text-underline-offset: 3px;
		transition: color 0.25s var(--ease-hz), text-decoration-color 0.25s var(--ease-hz);
	}
	.rodape__links a:hover,
	.rodape__links a:focus-visible {
		color: var(--tx);
		text-decoration-color: currentColor;
	}

	/* celular: duas linhas, centralizadas */
	@media (max-width: 599px) {
		.rodape__inner {
			flex-direction: column;
			text-align: center;
		}
	}

	@media (min-width: 900px) and (min-aspect-ratio: 1/1) {
		.rodape {
			padding: calc(24 * var(--fu)) calc(56 * var(--fu));
		}
		.rodape__inner {
			max-width: calc(1100 * var(--fu));
		}
		.rodape__texto,
		.rodape__copy,
		.rodape__links {
			font-size: calc(13.5 * var(--fu));
		}
		.rodape__aviso {
			font-size: calc(12 * var(--fu));
		}
	}
</style>
