---
/**
 * Dobra 03 — A virada.
 * Copy: "Copy do Site MVP.md", Página 3 (sem alterações). A imagem prevista na
 * copy (checklist "Financiamento Minha Casa, Minha Vida") foi montada como cartão
 * do DS, com os cinco itens da própria copy.
 *
 * Transição da dobra 2 (clara, o problema) para a 3 (moldura escura do DS, a
 * solução): a moldura verde arredondada, com anel de 8px, é o contraponto
 * "claro → escuro" do Hanzo. O cartão branco do checklist é a peça de luz.
 */
import iconeCheck from '@phosphor-icons/core/assets/fill/check-circle-fill.svg?raw';
import iconeCasa from '@phosphor-icons/core/assets/regular/house-line.svg?raw';

const itens = ['Enquadramento', 'Subsídio', 'Uso do FGTS', 'Entrada e parcelas', 'Próximas etapas'];
---

<section id="virada" class="virada" aria-labelledby="virada-title">
	<div class="virada__frame on-ink">
		<div class="rays" aria-hidden="true">
			<div class="rays-in"><i class="r1"></i><i class="r3"></i><i class="r4"></i></div>
		</div>

		<div class="virada__inner">
			<div class="virada__text">
				<h2 id="virada-title" class="virada__title rv">
					Mas não precisava ser <em class="acc">assim.</em>
					<span class="t2">Suas próximas vendas podem ter um final diferente.</span>
				</h2>

				<div class="virada__body">
					<p class="rv" style="--i:1">
						Quando você entende as regras do financiamento, consegue identificar possíveis obstáculos logo nos
						primeiros atendimentos, esclarecer dúvidas sobre renda, FGTS e subsídio e preparar melhor o cliente
						para cada etapa da negociação.
					</p>
					<p class="virada__payoff rv" style="--i:2">
						Em vez de descobrir um problema quando a venda já está avançada, você conduz a negociação com mais
						clareza, segurança e menos surpresas.
					</p>
				</div>
			</div>

			<div class="virada__card rv" style="--i:2">
				<div class="virada__card-head">
					<span class="virada__card-ico" aria-hidden="true" set:html={iconeCasa} />
					<h3>Financiamento Minha Casa, Minha Vida</h3>
				</div>
				<ul class="virada__list">
					{
						itens.map((texto, i) => (
							<li class="rv" style={`--i:${i + 3}`}>
								<span class="virada__check" aria-hidden="true" set:html={iconeCheck} />
								<span>{texto}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	/* a faixa clara em volta da moldura continua o campo da dobra 2 */
	.virada {
		position: relative;
		z-index: 2;
		padding: 0 var(--frame-gap) var(--frame-gap);
		background: var(--field);
	}

	.virada__frame {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		padding: clamp(64px, 9vw, 150px) clamp(24px, 5vw, 88px);
		border-radius: var(--frame-radius);
		/* moldura escura do DS: radial a partir do canto, anel de 8px */
		background: radial-gradient(100% 100% at 0% 0%, var(--v800) 0%, var(--v950) 100%);
		box-shadow: 0 0 0 8px var(--ring);
		color: #fff;
	}
	/* raios de luz do DS sobre tinta: 5% */
	.virada__frame :global(.rays i) {
		opacity: 0.05;
	}

	.virada__inner {
		position: relative;
		z-index: 2;
		max-width: 1240px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
		gap: clamp(40px, 6vw, 96px);
		align-items: center;
	}

	.virada__title {
		font-family: var(--f-title);
		font-weight: 500;
		font-size: clamp(2.2rem, 3.9vw, 4rem);
		line-height: 1.05;
		text-wrap: balance;
		letter-spacing: -0.055em;
		color: #fff;
	}
	.virada__title .acc {
		font-size: calc(1em * var(--acc-scale));
		letter-spacing: -0.01em;
		padding-right: 0.04em;
	}
	.virada__title .t2 {
		display: block;
		margin-top: 0.1em;
		text-wrap: balance;
	}

	.virada__body {
		display: flex;
		flex-direction: column;
		gap: 1em;
		max-width: 36rem;
		margin-top: clamp(24px, 3.4vw, 44px);
		font: 400 clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem) / 1.6 var(--f-display);
		letter-spacing: -0.01em;
		color: rgba(255, 255, 255, 0.74);
	}
	.virada__body p {
		margin: 0;
	}
	.virada__payoff {
		color: #fff;
	}

	/* ----------------------------------------------------------- checklist */
	.virada__card {
		padding: clamp(22px, 2.6vw, 34px) clamp(22px, 2.8vw, 38px) clamp(8px, 1vw, 14px);
		border-radius: 24px;
		background: var(--surface);
		color: var(--tx);
		box-shadow:
			0 0 0 8px rgba(255, 255, 255, 0.25),
			0 30px 60px -24px rgba(0, 0, 0, 0.5);
	}
	.virada__card-head {
		display: flex;
		align-items: center;
		gap: 14px;
		padding-bottom: clamp(16px, 2vw, 24px);
		border-bottom: 1px solid var(--hair);
	}
	.virada__card-ico {
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--v200);
		color: var(--v700);
	}
	.virada__card-ico :global(svg) {
		width: 24px;
		height: 24px;
		fill: currentColor;
	}
	.virada__card-head h3 {
		margin: 0;
		font: 500 clamp(1rem, 0.9rem + 0.45vw, 1.25rem) / 1.25 var(--f-display);
		letter-spacing: -0.02em;
	}

	.virada__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.virada__list li {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: clamp(14px, 1.7vw, 20px) 0;
		border-bottom: 1px solid var(--hair);
		font: 400 clamp(1.125rem, 1rem + 0.7vw, 1.625rem) / 1.25 var(--f-display);
		letter-spacing: -0.035em;
	}
	.virada__list li:last-child {
		border-bottom: 0;
	}
	.virada__check {
		flex: none;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		color: var(--v500);
	}
	.virada__check :global(svg) {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	@media (max-width: 899px) {
		.virada__inner {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
