---
/**
 * Aviso de cookies (opção A: informativo). Uma faixa discreta no canto de baixo avisa que a página usa
 * cookies (Google Analytics e Pixel da Meta) e leva à Política de Privacidade. O botão "Entendi" grava a
 * escolha no navegador (localStorage) e a faixa não volta a aparecer.
 *
 * Nasce escondida (atributo `hidden`) e só um script a mostra, quando a escolha ainda não foi gravada:
 * sem JS ela simplesmente não aparece, e nada na página se desloca (a faixa é fixa, fora do fluxo).
 * Não bloqueia nem atrasa o Analytics ou o Pixel: esta versão só informa.
 */
---

<aside class="cookies" id="aviso-cookies" role="region" aria-label="Aviso de cookies" hidden>
	<p class="cookies__texto">Usamos cookies para medir o uso da página e melhorar nossos anúncios. Saiba mais na <a href="/cookies/">Política de Cookies</a>.</p>
	<button type="button" class="cookies__ok" id="aviso-cookies-ok">Entendi</button>
</aside>

<script>
	const CHAVE = 'hc-aviso-cookies';
	const aviso = document.getElementById('aviso-cookies');
	const botao = document.getElementById('aviso-cookies-ok');

	let jaViu = false;
	try {
		jaViu = localStorage.getItem(CHAVE) === '1';
	} catch {
		// armazenamento bloqueado: o aviso aparece, e fechar vale só para esta visita
	}

	if (aviso && botao && !jaViu) {
		aviso.hidden = false;
		botao.addEventListener('click', () => {
			aviso.hidden = true;
			try {
				localStorage.setItem(CHAVE, '1');
			} catch {
				/* sem armazenamento: tudo bem */
			}
		});
	}
</script>

<style>
	.cookies {
		position: fixed;
		z-index: 200;
		left: max(16px, env(safe-area-inset-left));
		right: max(16px, env(safe-area-inset-right));
		bottom: max(16px, env(safe-area-inset-bottom));
		display: flex;
		align-items: center;
		gap: 14px 20px;
		max-width: 620px;
		padding: 14px 16px 14px 20px;
		background: var(--surface);
		border-radius: 18px;
		box-shadow:
			0 0 0 1px rgba(var(--ink-rgb), 0.08),
			var(--sh-soft);
		color: var(--tx-body);
	}
	.cookies[hidden] {
		display: none;
	}
	.cookies__texto {
		margin: 0;
		flex: 1 1 auto;
		font: 400 14px / 1.5 var(--f-display);
		letter-spacing: -0.005em;
	}
	.cookies__texto a {
		color: var(--tx);
		text-decoration: underline;
		text-decoration-color: rgba(var(--ink-rgb), 0.3);
		text-underline-offset: 3px;
	}
	.cookies__texto a:hover,
	.cookies__texto a:focus-visible {
		text-decoration-color: currentColor;
	}
	.cookies__ok {
		flex: 0 0 auto;
		appearance: none;
		border: 0;
		cursor: pointer;
		padding: 11px 22px;
		border-radius: 999px;
		background: var(--v950);
		color: #fff;
		font: 500 14px / 1 var(--f-display);
		letter-spacing: -0.005em;
		-webkit-tap-highlight-color: transparent;
		transition: background-color 0.25s var(--ease-hz);
	}
	.cookies__ok:hover {
		background: var(--v700);
	}
	.cookies__ok:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* celular: a faixa ocupa a largura toda, texto em cima e botão embaixo à direita */
	@media (max-width: 599px) {
		.cookies {
			flex-direction: column;
			align-items: stretch;
			padding: 16px 18px;
		}
		.cookies__ok {
			align-self: flex-end;
		}
	}
</style>
