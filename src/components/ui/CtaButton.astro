---
/**
 * Botão de compra — receita ".btn.light" do DS para superfícies escuras:
 * pílula branca com anel translúcido de 8px, sombra longa, seta Phosphor
 * (a família de ícones do DS) em disco de tinta. Reutilizável nas próximas dobras.
 *
 * Convite ao clique (só com movimento permitido), num ciclo de 4,8s: um anel de luz
 * nasce do botão e se dissolve, um reflexo verde atravessa a pílula e a seta dá dois
 * toques para a direita. O resto do tempo ele fica quieto. No hover o ciclo para e
 * a seta troca de lugar.
 */
interface Props {
	href: string;
	class?: string;
	/** 'escuro' (padrão): pílula branca para fundos escuros. 'claro': pílula de tinta (botão
	 *  primário do DS) para fundos claros, com disco branco. */
	fundo?: 'escuro' | 'claro';
	/** 'tinta' (padrão): verde-floresta quase preto. 'beringela': pílula na beringela do DS (--b500),
	 *  só para a dobra que pedir (usa com fundo="claro"). */
	tom?: 'tinta' | 'beringela';
}

const { href, class: className, fundo = 'escuro', tom = 'tinta' } = Astro.props;
---

<a class:list={['cta', fundo === 'claro' && 'cta--claro', tom === 'beringela' && 'cta--beringela', className]} href={href}>
	<span class="cta__halo" aria-hidden="true"></span>
	<span class="cta__shine" aria-hidden="true"></span>
	<span class="cta__label"><slot /></span>
	<span class="cta__disc" aria-hidden="true">
		<svg class="cta__arrow" viewBox="0 0 256 256" width="18" height="18" focusable="false">
			<path
				d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
			></path>
		</svg>
		<svg class="cta__arrow cta__arrow--next" viewBox="0 0 256 256" width="18" height="18" focusable="false">
			<path
				d="M221.66,133.66l-72,72a8,8,0,0,1-11.32-11.32L196.69,136H40a8,8,0,0,1,0-16H196.69L138.34,61.66a8,8,0,0,1,11.32-11.32l72,72A8,8,0,0,1,221.66,133.66Z"
			></path>
		</svg>
	</span>
</a>

<style>
	.cta {
		--h: 60px;
		--disc: 44px;
		position: relative;
		isolation: isolate;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 22px;
		min-height: var(--h);
		padding: 0 calc((var(--h) - var(--disc)) / 2) 0 30px;
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink);
		text-decoration: none;
		font: 600 14.5px/1.2 var(--f-ui);
		letter-spacing: 0.06em;
		white-space: nowrap;
		/* anel de 8px sobre tinta (DS: .btn.on-ink-ring) + sombra longa do Hanzo */
		box-shadow:
			0 0 0 8px rgba(255, 255, 255, 0.14),
			0 0 44px -6px rgba(143, 199, 167, 0.34),
			0 22px 44px -18px rgba(0, 0, 0, 0.55),
			var(--sh-btn),
			inset 0 -4px 10px rgba(0, 0, 0, 0.05);
		transition:
			transform 0.45s var(--ease-out),
			box-shadow 0.45s var(--ease-out),
			background-color 0.3s var(--ease-hz);
		-webkit-tap-highlight-color: transparent;
	}

	/* reflexo: recortado na pílula (o botão em si não corta o anel) */
	.cta__shine {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		overflow: hidden;
		pointer-events: none;
	}
	.cta__shine::before {
		content: '';
		position: absolute;
		inset: -10% 0;
		width: 46%;
		background: linear-gradient(105deg, transparent 0%, rgba(64, 125, 92, 0.22) 50%, transparent 100%);
		transform: translateX(-130%) skewX(-18deg);
	}
	/* anel de luz que nasce da borda do anel de 8px e se dissolve */
	.cta__halo {
		position: absolute;
		inset: -8px;
		z-index: -2;
		border-radius: 999px;
		border: 2px solid rgba(255, 255, 255, 0.7);
		opacity: 0;
		pointer-events: none;
	}

	.cta__label {
		position: relative;
		padding-block: 6px;
	}

	.cta__disc {
		position: relative;
		flex: none;
		display: grid;
		place-items: center;
		width: var(--disc);
		height: var(--disc);
		border-radius: 50%;
		background: var(--ink);
		color: #fff;
		overflow: hidden;
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.14),
			inset 0 -6px 12px rgba(0, 0, 0, 0.35);
		transition: background-color 0.3s var(--ease-hz);
	}

	.cta__arrow {
		grid-area: 1 / 1;
		fill: currentColor;
		transition:
			transform 0.5s var(--ease-out),
			opacity 0.35s var(--ease-out);
	}
	.cta__arrow--next {
		transform: translateX(-160%);
		opacity: 0;
	}

	@media (hover: hover) {
		.cta:hover {
			transform: translateY(-2px);
			background: #f6f7f5;
			box-shadow:
				0 0 0 8px rgba(255, 255, 255, 0.24),
				0 0 60px -4px rgba(143, 199, 167, 0.5),
				0 28px 52px -18px rgba(0, 0, 0, 0.6),
				var(--sh-btn),
				inset 0 -4px 10px rgba(0, 0, 0, 0.04);
		}
		.cta:hover {
			scale: 1.025;
		}
		.cta:hover .cta__disc {
			background: var(--v600);
		}
		.cta:hover .cta__arrow {
			transform: translateX(160%);
			opacity: 0;
		}
		.cta:hover .cta__arrow--next {
			transform: none;
			opacity: 1;
		}
	}

	/* telas estreitas: disco menor, rótulo fluido; abaixo de ~340px o rótulo
	   pode quebrar em duas linhas em vez de empurrar a seta para fora */
	@media (max-width: 560px) {
		.cta {
			--h: 58px;
			--disc: 38px;
			gap: 12px;
			padding-left: 22px;
			font-size: clamp(12.5px, 3.6vw, 14px);
			letter-spacing: 0.035em;
		}
		.cta__label {
			flex: 1;
			min-width: 0;
			white-space: normal;
			text-align: center;
		}
	}

	/* convite ao clique: ciclo único de 4,8s, depois da entrada da dobra */
	@media (prefers-reduced-motion: no-preference) {
		.cta__halo {
			animation: cta-halo 4.8s ease-out 2.6s infinite;
		}
		.cta__shine::before {
			animation: cta-shine 4.8s ease-in-out 2.6s infinite;
		}
		.cta__arrow:not(.cta__arrow--next) {
			animation: cta-nudge 4.8s ease-in-out 2.6s infinite;
		}
		.cta:hover .cta__halo,
		.cta:hover .cta__arrow {
			animation: none;
		}
		.cta:hover .cta__shine::before {
			animation-duration: 1.8s;
		}
	}
	@keyframes cta-halo {
		0% {
			transform: scale(1);
			opacity: 0;
		}
		5% {
			opacity: 0.75;
		}
		34%,
		100% {
			transform: scale(1.14, 1.62);
			opacity: 0;
		}
	}
	@keyframes cta-shine {
		0%,
		38% {
			transform: translateX(-130%) skewX(-18deg);
		}
		68%,
		100% {
			transform: translateX(330%) skewX(-18deg);
		}
	}
	@keyframes cta-nudge {
		0%,
		40%,
		100% {
			transform: none;
		}
		10%,
		30% {
			transform: translateX(5px);
		}
		20% {
			transform: none;
		}
	}

	.cta:active {
		transform: scale(0.97);
		transition-duration: 0.15s;
	}

	/* foco acessível: anel verde 300 (9.3:1 sobre a tinta) afastado do botão */
	.cta:focus-visible {
		outline: 3px solid var(--v300);
		outline-offset: 5px;
	}

	/* ------------------------------------------------ variante para fundo CLARO
	   Pílula de tinta (o `.btn` primário do DS), disco branco com seta de tinta, anel de 8px
	   branco translúcido na "bandeja" do campo. O ciclo de convite é o mesmo. */
	.cta--claro {
		background: var(--ink);
		color: #fff;
		box-shadow:
			0 0 0 8px rgba(255, 255, 255, 0.55),
			0 22px 40px -18px rgba(14, 26, 19, 0.5),
			var(--sh-btn),
			inset 0 -4px 10px rgba(0, 0, 0, 0.25);
	}
	.cta--claro .cta__disc {
		background: #fff;
		color: var(--ink);
		box-shadow: inset 0 -4px 8px rgba(14, 26, 19, 0.08);
	}
	.cta--claro .cta__halo {
		border-color: rgba(var(--ink-rgb), 0.45);
	}
	.cta--claro .cta__shine::before {
		background: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, 0.22) 50%, transparent 100%);
	}
	@media (hover: hover) {
		.cta--claro:hover {
			background: var(--v900);
			box-shadow:
				0 0 0 8px rgba(255, 255, 255, 0.7),
				0 28px 50px -18px rgba(14, 26, 19, 0.55),
				var(--sh-btn),
				inset 0 -4px 10px rgba(0, 0, 0, 0.25);
		}
		.cta--claro:hover .cta__disc {
			background: var(--v200);
		}
	}
	.cta--claro:focus-visible {
		outline-color: var(--v500);
	}

	/* ------------------------------------------------ tom BERINGELA (acento único do DS)
	   Pílula sólida em --b500 (#7B416D, baixa saturação: nunca néon), texto branco (~7,6:1),
	   disco branco com seta beringela. Hover: --b700. Só em dobras que pedirem (prop tom). */
	.cta--beringela {
		background: var(--b500);
		box-shadow:
			0 0 0 8px rgba(255, 255, 255, 0.55),
			0 22px 40px -18px rgba(42, 23, 36, 0.55),
			var(--sh-btn),
			inset 0 -4px 10px rgba(0, 0, 0, 0.22);
	}
	.cta--beringela .cta__disc {
		background: #fff;
		color: var(--b500);
		box-shadow: inset 0 -4px 8px rgba(42, 23, 36, 0.1);
	}
	.cta--beringela .cta__halo {
		border-color: rgba(123, 65, 109, 0.5);
	}
	.cta--beringela .cta__shine::before {
		background: linear-gradient(105deg, transparent 0%, rgba(255, 255, 255, 0.28) 50%, transparent 100%);
	}
	@media (hover: hover) {
		.cta--beringela:hover {
			background: var(--b700);
			box-shadow:
				0 0 0 8px rgba(255, 255, 255, 0.7),
				0 28px 50px -18px rgba(42, 23, 36, 0.6),
				var(--sh-btn),
				inset 0 -4px 10px rgba(0, 0, 0, 0.22);
		}
		.cta--beringela:hover .cta__disc {
			background: var(--b200);
		}
	}
	.cta--beringela:focus-visible {
		outline-color: var(--b400);
	}
</style>
